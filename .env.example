# Copy this file to .env (already gitignored) and fill in real values, or
# export these as real environment variables however you normally do.
# token_refresh.py (both the root copy and microcap-analyzer/token_refresh.py)
# reads them at startup and refuses to run if any are missing.

# Upstox Developer App credentials — https://developer.upstox.com/apps
UPSTOX_API_KEY=
UPSTOX_API_SECRET=

# Optional — only needed if your Upstox app's redirect URI differs from the default.
# UPSTOX_REDIRECT_URI=http://127.0.0.1:8501/

# Telegram bot used to relay the Upstox login link and receive the auth code back.
# Create a bot via @BotFather to get TELEGRAM_BOT_TOKEN; TELEGRAM_CHAT_ID is your
# own numeric chat id (e.g. from @userinfobot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
